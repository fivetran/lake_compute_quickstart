#!/usr/bin/env bash
# Run dbt Fusion with .env loaded and this folder's profiles.yml.
# Usage (from anywhere): ./bin/dbtw build --selector fivetran_log
# Uses ./bin/dbt if you installed Fusion there, otherwise the dbt on your PATH.
# Reads .env line by line (no `source`), so values with spaces or quotes are safe and nothing is printed.
set -euo pipefail
cd "$(dirname "$0")/.."
[ -f .env ] || { echo "ERROR: .env not found. Copy .env.example to .env first." >&2; exit 1; }
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in ''|\#*) continue ;; esac
  key="${line%%=*}"; val="${line#*=}"
  val="${val%\"}"; val="${val#\"}"; val="${val%\'}"; val="${val#\'}"
  [[ "$key" =~ ^[A-Z_][A-Z0-9_]*$ ]] && export "$key=$val"
done < .env
if [ -x ./bin/dbt ]; then dbt=./bin/dbt; else dbt="$(command -v dbt || true)"; fi
[ -n "$dbt" ] || { echo "ERROR: dbt Fusion not found. See step 1 in README.md." >&2; exit 1; }
exec "$dbt" "$@" --profiles-dir .
