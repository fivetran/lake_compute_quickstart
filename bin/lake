#!/bin/sh
# DuckDB connected straight to your lake's Iceberg catalog, as `lake`. No Fivetran or dbt involved.
#   ./bin/lake                       interactive SQL prompt
#   ./bin/lake -c "select ..."       run one query
# Example: select * from lake.quickstart_fivetran_platform.fivetran_platform__connection_status;
# The work happens in scripts/lc.py (`lake` command), which also runs on Windows through bin\lake.cmd.
exec python3 "$(dirname "$0")/../scripts/lc.py" lake "$@"
