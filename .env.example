# Lake Compute quickstart settings. Copy to .env, keep it private (chmod 600), never commit it.
# Fill in values in your own editor. Don't paste them into a chat or a terminal.

# Step 0: your Fivetran API key and secret (Fivetran dashboard -> your user menu -> API key)
FIVETRAN_API_KEY=
FIVETRAN_API_SECRET=

# Step 3: Lake Compute token, generated on your Managed Data Lake destination's Lake Compute page (starts with dct_)
LAKE_COMPUTE_TOKEN=

# Step 6: your catalog's client ID and secret, as a pair, for querying the lake directly with DuckDB
POLARIS_CLIENT_ID=
POLARIS_CLIENT_SECRET=

# Filled in by scripts/lc.py. Not secrets.
FIVETRAN_GROUP_ID=
LC_CATALOG=
POLARIS_ENDPOINT=
MDLS_BUCKET=
MDLS_PREFIX=
MDLS_REGION=
LOG_SCHEMA=
LOG_CONNECTION_ID=

# dbt Fusion settings. Lake Compute is an experimental adapter in released Fusion builds.
DBT_ALLOW_EXPERIMENTAL_ADAPTERS=true
DBT_ENGINE_EXPERIMENTAL_MULTI_ADAPTER=true
# Avoids a Fusion startup crash when Lake Compute is the only adapter (profiles.yml's base_url also avoids it).
DBT_SEND_ANONYMOUS_USAGE_STATS=false
